PORT=8080

# 本地免登录模式：跳过鉴权、按单用户运行、只监听 127.0.0.1。
# 线上务必保持 false —— 免登录 + 公网 = 灾难。
LOCAL_MODE=false
# 前端产物目录；不存在则跳过静态托管（线上由 Nginx 直发 /app/）
FRONTEND_DIR=

SESSION_HOURS=12
RETENTION_DAYS=30
MAX_JOB_WORKERS=2
# 单次发信的文件数与收件人数上限
MAX_EMAIL_FILES=20
MAX_EMAIL_RECIPIENTS=20
MAX_UPLOAD_BYTES=209715200
MAX_EXTRACTED_BYTES=1073741824
MAX_EXTRACTED_FILES=5000
# 不设置时按 LOCAL_MODE 自动决定（本地 false / 线上 true）；一般无需显式配置
# SECURE_COOKIES=true
DEFAULT_ADMIN_USERNAME=admin
# 必填，至少 12 位随机字符，切勿使用默认值
DEFAULT_ADMIN_PASSWORD=
SMTP_HOST=smtp.139.com
SMTP_PORT=465
SMTP_USERNAME=your_email@139.com
SMTP_PASSWORD=your_authorization_code
SMTP_FROM_NAME=华为巡检云平台
